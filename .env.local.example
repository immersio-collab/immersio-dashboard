# -----------------------------------------------------------------------------
# Immersio Dashboard — environment variables template.
# Copy this file to `.env.local` and fill in the values.
# Never commit the real `.env.local` (already gitignored).
# -----------------------------------------------------------------------------

# --- Required for app startup ------------------------------------------------
# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_anon_or_service_key

# Shared secret sent to the leads script for authenticated calls.
LEADS_SECRET=

# Argon2/bcrypt hash of the dashboard password (used for login).
DASHBOARD_PASSWORD_HASH=123456

# Long random secret used to sign session cookies (min. 32 chars recommended).
SESSION_SECRET=

# --- Future integrations (enable when needed) --------------------------------
# Uncomment and provide values when the corresponding features are implemented.
# Referenced emplacements exist in lib/config.ts alongside leads config.

# External script providing portfolio entries data.
# PORTFOLIO_SCRIPT_URL=

# External script providing blog posts data.
# BLOG_SCRIPT_URL=

# External script providing tours/discovery data (lives in its own config file).
# TOURS_SCRIPT_URL=

# -----------------------------------------------------------------------------
# Immersio Dashboard — environment variables template.
# Copy this file to `.env.local` and fill in the values.
# Never commit the real `.env.local` (already gitignored).
# -----------------------------------------------------------------------------

# --- Required for app startup ------------------------------------------------
# Validated at startup by lib/config.ts — the app refuses to boot without them.

# Supabase connection.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# CRITICAL: This must be the secret 'service_role' key (not the public 'anon' key).
# The backend uses this key to bypass Row-Level Security (RLS) for server-side queries.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Argon2/bcrypt hash of the dashboard password (used for login).
# Generate it with: npm run hash-password
DASHBOARD_PASSWORD_HASH=

# Long random secret used to sign session cookies (min. 32 chars recommended).
SESSION_SECRET=

# --- Meta leads webhook ------------------------------------------------------
# Shared secret the Google Apps Script must send on POST /api/leads/webhook.
# Must match SECRET_KEY in scripts/google-apps-script/sync-to-supabase.gs.
WEBHOOK_SECRET=

# --- Public site revalidation (tours) ----------------------------------------
# When a tour is created/updated/deleted, the dashboard tells immersio.ma to
# drop its cached /visite/[slug] page so the change is live immediately.
# Both are optional: without them the site still picks the change up on its
# own ISR window (5 min) instead of instantly, and a warning is logged.
SITE_REVALIDATE_URL=https://immersio.ma/api/revalidate
# Must match REVALIDATION_SECRET in the immersio.ma project exactly.
REVALIDATION_SECRET=

# --- Future integrations (enable when needed) --------------------------------
# Declared as optional keys in lib/config.ts, with typed accessors already
# wired. Uncomment and fill in when the corresponding feature is built.

# External script providing portfolio entries data.
# PORTFOLIO_SCRIPT_URL=

# External script providing blog posts data.
# BLOG_SCRIPT_URL=
